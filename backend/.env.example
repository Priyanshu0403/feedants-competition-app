NODE_ENV=development
PORT=4000

# Local: mongod running on default port. Atlas: paste your SRV connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# How long an unpaid registration reserves a spot before it's released.
RESERVATION_WINDOW_MINUTES=10

# Comma separated list of allowed origins, or * for any.
CLIENT_ORIGIN=*

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
